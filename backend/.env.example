# =====================================================================
# AI Phishing Defense Platform — Backend Environment Configuration
# =====================================================================

# Database Connection URL (MySQL or SQLite)
# For managed MySQL (e.g. TiDB Cloud / Aiven / Railway):
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_verify_cert=true
DATABASE_URL=sqlite:///./phishing_defense.db

# JWT Secret Key for signing authentication session tokens
# Generate a secure 32+ character random string in production
JWT_SECRET=supersecretjwtkeyforaiphishingdefenseplatform

# Allowed CORS Origins (comma-separated list of allowed frontend domains)
# Example: https://ai-phishing-defense.vercel.app,http://localhost:5173,http://10.0.2.2:5173
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173,http://10.0.2.2:5173

# Default Admin User Credentials (automatically seeded if not present)
ADMIN_EMAIL=admin@phishguard.ai
ADMIN_PASSWORD=AdminPassword123!

# Runtime Environment and Port
ENVIRONMENT=production
PORT=8000

# Optional: Path to ML models directory if stored in custom path
# ML_MODEL_DIR=/opt/render/project/src/ml_model

# Optional: SMTP Email Relay Configuration (Brevo, Gmail, SendGrid)
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@phishguard.ai
